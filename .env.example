# ==============================================================================
# BSTE ISLAMABAD - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Supabase PostgreSQL)
# ------------------------------------------------------------------------------
# DATABASE_URL: Transaction Pooler connection string (Port 6543, pgbouncer=true)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Direct Session connection string for Prisma migrations (Port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION SECRETS
# ------------------------------------------------------------------------------
# JWT_SECRET: 64+ char random cryptographic key used to sign Admin session tokens
# (Generate with: openssl rand -base64 48)
JWT_SECRET="your_production_secure_jwt_secret_key_change_in_production"

# ------------------------------------------------------------------------------
# 3. APPLICATION DOMAIN & PUBLIC URL
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_APP_URL: Full production URL for QR code generation and verification links
# e.g., https://bste-islamabad.edu.pk or https://your-project.vercel.app
NEXT_PUBLIC_APP_URL="https://your-domain.edu.pk"

# ------------------------------------------------------------------------------
# 4. ENVIRONMENT MODE
# ------------------------------------------------------------------------------
NODE_ENV="production"
